{
  "manifest_version": 3,
  "name": "PingCode 工作台连接",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "通过当前浏览器的 PingCode 标签页为本机工作台提供任务查询。",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.pingcode.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PingCode 工作台连接"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  }
}
